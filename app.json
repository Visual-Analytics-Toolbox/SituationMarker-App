{
  "expo": {
    "name": "SituationMarkerApp",
    "slug": "SituationMarkerApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/situation_marker.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1d8cdd"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "permissions": [
        "INTERNET",
        "ACCESS_WIFI_STATE",
        "CHANGE_WIFI_MULTICAST_STATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/situation_marker.png",
        "backgroundColor": "#1d8cdd"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.SituationMarkerApp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow SituationMarker to access your microphone.",
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false
        }
      ],
      "expo-font",
      "expo-asset"
    ]
  }
}
